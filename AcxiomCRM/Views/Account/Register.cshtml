@model RegisterVm
@{ ViewData["Title"]="Register"; }
<div class="auth panel"><div class="eyebrow">Get started</div><h1>Create your account.</h1><p class="intro">New accounts receive the SalesExecutive role. Your administrator controls additional access.</p><form method="post" asp-action="Register"><div asp-validation-summary="All" role="alert"></div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" required/><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" minlength="10" required/><p class="small text-muted">At least 10 characters, with uppercase, lowercase, a number and a symbol.</p><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" required/><button class="btn btn-primary w-100">Create account</button></form></div>
