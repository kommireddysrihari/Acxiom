@model DashboardVm
@{ViewData["Title"]="Overview";var ops=Model.Opportunities;var leads=Model.Leads;var open=ops.Where(x=>x.Status=="Open").ToList();var leadGroups=leads.GroupBy(x=>x.Status).Select(g=>new{label=g.Key,value=g.Count()});var stages=Modules.Stages.Select(s=>new{label=s,value=ops.Where(x=>x.Stage==s).Sum(x=>x.Amount)});var months=Enumerable.Range(0,6).Select(i=>new DateTime(DateTime.UtcNow.Year,DateTime.UtcNow.Month,1).AddMonths(i-5)).Select(m=>new{label=m.ToString("MMM yyyy"),value=ops.Where(x=>x.Status=="Won"&&x.ClosedDate.HasValue&&x.ClosedDate.Value.Year==m.Year&&x.ClosedDate.Value.Month==m.Month).Sum(x=>x.Amount)});}
<div class="eyebrow">Your business at a glance</div><div class="toolbar"><div><h1>Sales overview</h1><p class="intro mb-0">A clear view of your relationships, pipeline and next steps.</p></div><a href="/crm/leads/new" class="btn btn-primary">+ New lead</a></div>
<form class="filters" method="get"><select name="period" class="form-select" aria-label="Period"><option value="all">All time / custom</option><option value="today">Today</option><option value="week">This week</option><option value="month">This month</option></select><input name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" aria-label="From"/><input name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" aria-label="To"/><button class="btn btn-outline-secondary">Update</button></form><p class="small text-muted">Date filters select records by creation date. Follow-ups show all pending work. Monthly sales use the selected opportunities' actual won date.</p>
<div class="metrics"><div class="metric primary"><span>OPEN PIPELINE</span><strong>₹@open.Sum(x=>x.Amount).ToString("N0")</strong><small>Weighted: ₹@open.Sum(x=>x.Amount*x.Probability/100).ToString("N0")</small></div>
@foreach(var card in new[]{("Total customers",Model.Customers.Count),("Total leads",leads.Count),("Open leads",leads.Count(x=>x.Status is "New" or "Contacted" or "Qualified")),("Total opportunities",ops.Count),("Open opportunities",open.Count),("Won opportunities",ops.Count(x=>x.Status=="Won")),("Lost opportunities",ops.Count(x=>x.Status=="Lost"))}){<div class="metric"><span>@card.Item1.ToUpperInvariant()</span><strong>@card.Item2</strong><small>Within your scope</small></div>}</div>
<div class="charts"><section class="panel"><h2>Lead status</h2><div class="chart-box"><canvas id="lead-chart" aria-label="Lead status chart"></canvas></div><p class="chart-fallback">@string.Join(" · ",leadGroups.Select(x=>$"{x.label}: {x.value}"))</p></section><section class="panel"><h2>Opportunity pipeline</h2><div class="chart-box"><canvas id="pipeline-chart" aria-label="Pipeline chart"></canvas></div><p class="chart-fallback">@string.Join(" · ",stages.Select(x=>$"{x.label}: ₹{x.value:N0}"))</p></section><section class="panel"><h2>Monthly won sales</h2><div class="chart-box"><canvas id="sales-chart" aria-label="Monthly sales chart"></canvas></div><p class="chart-fallback">@string.Join(" · ",months.Select(x=>$"{x.label}: ₹{x.value:N0}"))</p></section><section class="panel"><h2>Upcoming & overdue</h2><p class="text-muted small">@Model.FollowUps.Count(x=>x.Status=="Planned") pending follow-ups</p>@foreach(var f in Model.FollowUps.Where(x=>x.Status=="Planned").OrderBy(x=>x.FollowUpDate).Take(7)){<div class="border-bottom py-3"><a href="/crm/followups/@f.Id">@f.Name</a><span class="float-end @(f.FollowUpDate<DateTime.UtcNow.Date?"text-danger":"text-muted")">@f.FollowUpDate?.ToString("dd MMM")</span></div>}</section></div>
@section Scripts{
<script src="/vendor/chart.umd.min.js"></script><script>
if(window.Chart){const lead=@Html.Raw(JsonSerializer.Serialize(leadGroups));const pipeline=@Html.Raw(JsonSerializer.Serialize(stages));const sales=@Html.Raw(JsonSerializer.Serialize(months));function draw(id,type,data){new Chart(document.getElementById(id),{type,data:{labels:data.map(x=>x.label),datasets:[{data:data.map(x=>x.value),backgroundColor:['#147d74','#66b9a7','#e5b967','#718cb1','#c77b82','#aebdcb'],borderColor:'#147d74',tension:.3}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:type==='doughnut'}},scales:type==='doughnut'?{}:{y:{beginAtZero:true}}}});}draw('lead-chart','doughnut',lead);draw('pipeline-chart','bar',pipeline);draw('sales-chart','line',sales);}
</script>}
