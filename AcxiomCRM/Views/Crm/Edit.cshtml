@model RecordDto
@{ViewData["Title"]=Model.Id==Guid.Empty?"Create record":"Edit record";}
<div class="eyebrow">@Model.Kind</div><h1>@ViewData["Title"]</h1><p class="intro">Fields are validated here and again on the server.</p><div class="panel"><form asp-action="Save" asp-route-kind="@Model.Kind" method="post" data-crm="@Model.Kind"><input asp-for="Id" type="hidden"/><input asp-for="Version" type="hidden"/><input asp-for="Kind" type="hidden"/><div asp-validation-summary="All" role="alert"></div><div class="row g-4">
<div class="col-md-6"><label asp-for="Name" class="form-label">Name / subject</label><input asp-for="Name" class="form-control" required maxlength="120"/><span asp-validation-for="Name"></span></div>
<div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select">@foreach(var s in Modules.Statuses(Model.Kind)){<option value="@s">@s</option>}</select><span asp-validation-for="Status"></span></div>
<div class="col-md-6"><label asp-for="AssignedTo" class="form-label">Assigned owner</label><select asp-for="AssignedTo" class="form-select">@foreach(var o in (List<Choice>)ViewBag.Owners){<option value="@o.Id">@o.Name</option>}</select><span asp-validation-for="AssignedTo"></span></div>
@if(Model.Kind is "customers" or "leads"){
<div class="col-md-6"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" required type="email" maxlength="254"/><span asp-validation-for="Email"></span></div>
<div class="col-md-6"><label asp-for="Phone" class="form-label">Mobile number</label><input asp-for="Phone" class="form-control" required pattern="[6-9][0-9]{9}" maxlength="10"/><span asp-validation-for="Phone"></span></div>
<div class="col-md-6"><label asp-for="CompanyName" class="form-label">Company</label><input asp-for="CompanyName" class="form-control" maxlength="120"/><span asp-validation-for="CompanyName"></span></div>
}
@if(Model.Kind=="customers"){
<div class="col-md-6"><label asp-for="Address" class="form-label">Address</label><input asp-for="Address" class="form-control" maxlength="300"/><span asp-validation-for="Address"></span></div>
<div class="col-md-6"><label asp-for="City" class="form-label">City</label><input asp-for="City" class="form-control" maxlength="80"/><span asp-validation-for="City"></span></div>
<div class="col-md-6"><label asp-for="State" class="form-label">State</label><input asp-for="State" class="form-control" maxlength="80"/><span asp-validation-for="State"></span></div>
}
@if(Model.Kind=="leads"){
<div class="col-md-6"><label asp-for="ExpectedValue" class="form-label">Expected value (INR)</label><input asp-for="ExpectedValue" class="form-control" type="number" min="0" max="100000000000" step="0.01" required/><span asp-validation-for="ExpectedValue"></span></div>
<div class="col-md-6"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select"><option>Low</option><option>Normal</option><option>High</option></select></div>}@if(Model.Kind is "leads" or "opportunities"){
<div class="col-md-6"><label asp-for="Source" class="form-label">Source</label><input asp-for="Source" class="form-control" maxlength="80"/><span asp-validation-for="Source"></span></div>
}
@if(Model.Kind=="opportunities"){
<div class="col-md-6"><label asp-for="Amount" class="form-label">Amount (INR)</label><input asp-for="Amount" class="form-control" type="number" min="0.01" max="100000000000" step="0.01" required/><span asp-validation-for="Amount"></span></div>
<div class="col-md-6"><label asp-for="Probability" class="form-label">Probability (%)</label><input asp-for="Probability" class="form-control" type="number" min="0" max="100" required/><span asp-validation-for="Probability"></span></div>
<div class="col-md-6"><label asp-for="ExpectedCloseDate" class="form-label">Expected close date</label><input asp-for="ExpectedCloseDate" class="form-control" type="date" required/><span asp-validation-for="ExpectedCloseDate"></span></div>
<div class="col-md-6"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" class="form-select">@foreach(var s in Modules.Stages){<option>@s</option>}</select></div>}@if(Model.Kind is "opportunities" or "followups" or "activities"){
<div class="col-md-6"><label asp-for="CustomerId" class="form-label">Related customer</label><select asp-for="CustomerId" class="form-select"><option value="">None</option>@foreach(var r in (List<RecordDto>)ViewData["customers"]!){<option value="@r.Id">@r.Name</option>}</select><span asp-validation-for="CustomerId"></span></div><div class="col-md-6"><label asp-for="LeadId" class="form-label">Related lead</label><select asp-for="LeadId" class="form-select"><option value="">None</option>@foreach(var r in (List<RecordDto>)ViewData["leads"]!){<option value="@r.Id">@r.Name</option>}</select><span asp-validation-for="LeadId"></span></div>}
@if(Model.Kind=="followups"){<div class="col-md-6"><label asp-for="FollowUpDate" class="form-label">Follow-up date</label><input asp-for="FollowUpDate" class="form-control" type="date" required/><span asp-validation-for="FollowUpDate"></span></div>
<div class="col-md-6"><label asp-for="FollowUpType" class="form-label">Follow-up type</label><select asp-for="FollowUpType" class="form-select">@foreach(var t in Modules.Types){<option>@t</option>}</select></div><div class="col-md-6"><label asp-for="OpportunityId" class="form-label">Related opportunity</label><select asp-for="OpportunityId" class="form-select"><option value="">None</option>@foreach(var r in (List<RecordDto>)ViewData["opportunities"]!){<option value="@r.Id">@r.Name</option>}</select></div>}@if(Model.Kind=="activities"){<div class="col-md-6"><label asp-for="ActivityDate" class="form-label">Activity date</label><input asp-for="ActivityDate" class="form-control" type="date" required/><span asp-validation-for="ActivityDate"></span></div>
<div class="col-md-6"><label asp-for="ActivityType" class="form-label">Activity type</label><select asp-for="ActivityType" class="form-select">@foreach(var t in Modules.Types){<option>@t</option>}</select></div>}<div class="col-12"><label asp-for="Notes" class="form-label">Notes / remarks / description</label><textarea asp-for="Notes" class="form-control" rows="4" maxlength="2000"></textarea><span asp-validation-for="Notes"></span></div></div><div class="mt-4"><button class="btn btn-primary">Save record</button><a class="btn btn-link" href="/crm/@Model.Kind">Cancel</a></div></form></div>
