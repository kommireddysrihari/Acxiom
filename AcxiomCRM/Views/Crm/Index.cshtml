@model ListVm
@{ViewData["Title"]=Model.Kind;var owners=(List<Choice>)ViewBag.Owners;}
<div class="eyebrow">CRM workspace</div><div class="toolbar"><div><h1>@(System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(Model.Kind))</h1><p class="intro mb-0">@Model.Total records in your authorized scope</p></div><a class="btn btn-primary" href="/crm/@Model.Kind/new">+ Create record</a></div>
<div class="panel"><form method="get" class="filters"><input name="q" value="@Model.Q" class="form-control" placeholder="Search name, email, company…" aria-label="Search"/><select name="status" class="form-select" aria-label="Status"><option value="">All statuses</option>@foreach(var status in Modules.Statuses(Model.Kind)){<option selected="@(status==Model.Status)" value="@status">@status</option>}</select><select name="owner" class="form-select" aria-label="Owner"><option value="">All owners</option>@foreach(var owner in owners){<option selected="@(owner.Id==Model.Owner)" value="@owner.Id">@owner.Name</option>}</select><input name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" aria-label="From date"/><input name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" aria-label="To date"/><select name="sort" class="form-select" aria-label="Sort">@foreach(var sort in new[]{"newest","oldest","name","amount"}){<option selected="@(sort==Model.Sort)">@sort</option>}</select><button class="btn btn-outline-secondary">Apply filters</button><a href="/crm/@Model.Kind" class="btn btn-link">Reset</a></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Name / subject</th><th>Status</th><th>Owner</th><th>Details</th><th>Created</th><th></th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td><a href="/crm/@Model.Kind/@row.Id"><strong>@row.Name</strong></a><br/><small class="text-muted">@row.CompanyName</small></td><td><span class="badge-soft">@row.Status</span></td><td>@(owners.FirstOrDefault(o=>o.Id==row.AssignedTo)?.Name??row.AssignedTo)</td><td>@if(Model.Kind=="opportunities"){<span>@row.Stage · ₹@row.Amount.ToString("N0")</span>}else if(Model.Kind=="followups"){<span>@row.FollowUpDate?.ToString("dd MMM yyyy")</span>@if(row.Status=="Planned"&&row.FollowUpDate<DateTime.UtcNow.Date){<strong class="text-danger"> Overdue</strong>}}else{<span>@row.Email @(Model.Kind=="activities"?row.ActivityType:row.RelatedName)</span>}</td><td>@row.CreatedDate.ToString("dd MMM yyyy")</td><td><a href="/crm/@Model.Kind/@row.Id/edit">Edit</a></td></tr>}</tbody></table></div>
@if(Model.Rows.Count==0){<p class="text-muted py-4 text-center">No matching records. Create a record or change the filters.</p>}
<div class="pagination-row"><span>Page @Model.Page · @Model.Total records</span>@if(Model.Page>1){<a asp-action="Index" asp-route-kind="@Model.Kind" asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Q" asp-route-status="@Model.Status" asp-route-owner="@Model.Owner" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-sort="@Model.Sort">Previous</a>}@if(Model.Page*15<Model.Total){<a asp-action="Index" asp-route-kind="@Model.Kind" asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Q" asp-route-status="@Model.Status" asp-route-owner="@Model.Owner" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-sort="@Model.Sort">Next</a>}</div></div>
