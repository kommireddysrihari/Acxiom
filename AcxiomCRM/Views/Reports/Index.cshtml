@model List<string[]>
@{ViewData["Title"]="Reports";var headers=(string[])ViewBag.Headers;var query=Context.Request.Query.Where(x=>x.Key!="export"&&x.Key!="page").ToDictionary(x=>x.Key,x=>(string?)x.Value.ToString());}
<div class="eyebrow">Insights & exports</div><h1>Reports</h1><p class="intro">Reports and exports use the same access rules as CRM records.</p><div class="panel"><form class="filters"><select name="kind" class="form-select" aria-label="Report">@foreach(var k in Modules.All.Concat(new[]{"pipeline","conversion","useractivity","audit"})){if(k=="audit"&&!User.IsInRole(Roles.Admin)){continue;}if(k=="useractivity"&&User.IsInRole(Roles.Sales)){continue;}<option value="@k" selected="@(k==(string)ViewBag.Kind)">@k</option>}</select><input name="q" class="form-control" value="@Context.Request.Query["q"]" placeholder="Search" aria-label="Search"/><input name="status" class="form-control" value="@Context.Request.Query["status"]" placeholder="Status / stage" aria-label="Status"/><select name="owner" class="form-select" aria-label="Owner"><option value="">All owners</option>@foreach(var o in (List<Choice>)ViewBag.Owners){<option value="@o.Id" selected="@(o.Id==Context.Request.Query["owner"].ToString())">@o.Name</option>}</select><input name="from" type="date" value="@Context.Request.Query["from"]" class="form-control" aria-label="From"/><input name="to" type="date" value="@Context.Request.Query["to"]" class="form-control" aria-label="To"/><select name="sort" class="form-select" aria-label="Sort">@foreach(var s in new[]{"newest","oldest","name","amount"}){<option selected="@(s==Context.Request.Query["sort"].ToString())">@s</option>}</select><button class="btn btn-outline-secondary">Run report</button></form><a class="btn btn-primary mb-3" href="@Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/Reports",query.Append(new KeyValuePair<string,string?>("export","true")).ToDictionary(x=>x.Key,x=>x.Value))">Export CSV</a><div class="table-responsive"><table class="table"><thead><tr>@foreach(var h in headers){<th>@h</th>}</tr></thead><tbody>@foreach(var row in Model){<tr>@foreach(var cell in row){<td>@cell</td>}</tr>}</tbody></table></div><div class="pagination-row"><span>Page @ViewBag.Page · @ViewBag.Total rows</span>@if((int)ViewBag.Page>1){<a href="@Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/Reports",query.Append(new KeyValuePair<string,string?>("page",((int)ViewBag.Page-1).ToString())).ToDictionary(x=>x.Key,x=>x.Value))">Previous</a>}@if((int)ViewBag.Page*25<(int)ViewBag.Total){<a href="@Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/Reports",query.Append(new KeyValuePair<string,string?>("page",((int)ViewBag.Page+1).ToString())).ToDictionary(x=>x.Key,x=>x.Value))">Next</a>}</div></div>
