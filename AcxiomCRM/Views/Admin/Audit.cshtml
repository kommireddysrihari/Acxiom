@model List<AuditLog>
@{ViewData["Title"]="Audit log";}
<div class="eyebrow">Security & accountability</div><h1>Audit log</h1><div class="panel"><form class="filters"><input name="q" value="@Context.Request.Query["q"]" class="form-control" placeholder="Action" aria-label="Action"/><input name="module" value="@Context.Request.Query["module"]" class="form-control" placeholder="Module" aria-label="Module"/><input name="user" value="@Context.Request.Query["user"]" class="form-control" placeholder="User ID" aria-label="User ID"/><input name="from" type="date" value="@Context.Request.Query["from"]" class="form-control" aria-label="From"/><input name="to" type="date" value="@Context.Request.Query["to"]" class="form-control" aria-label="To"/><button class="btn btn-outline-secondary">Apply filters</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Date (UTC)</th><th>User</th><th>Action</th><th>Module</th><th>Result / details</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.CreatedDate.ToString("u")</td><td>@a.UserId</td><td>@a.Action</td><td>@a.EntityName</td><td><details><summary>@a.Result</summary><p>Record: @a.RecordId · IP: @a.IpAddress</p><pre>@a.OldValue</pre><pre>@a.NewValue</pre></details></td></tr>}</tbody></table></div><div class="pagination-row"><span>Page @ViewBag.Page · @ViewBag.Total events</span>@if(ViewBag.Page>1){<a href="@Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path,Context.Request.Query.Where(x=>x.Key!="page").ToDictionary(x=>x.Key,x=>(string?)x.Value.ToString()).Append(new KeyValuePair<string,string?>("page",((int)ViewBag.Page-1).ToString())).ToDictionary(x=>x.Key,x=>x.Value))">Previous</a>}@if((int)ViewBag.Page*50<(int)ViewBag.Total){<a href="@Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path,Context.Request.Query.Where(x=>x.Key!="page").ToDictionary(x=>x.Key,x=>(string?)x.Value.ToString()).Append(new KeyValuePair<string,string?>("page",((int)ViewBag.Page+1).ToString())).ToDictionary(x=>x.Key,x=>x.Value))">Next</a>}</div></div>
