@model List<UserVm>
@{ViewData["Title"]="Users & roles";}
<div class="eyebrow">Administration</div><div class="toolbar"><h1>Users & roles</h1><a asp-action="Edit" class="btn btn-primary">+ Create user</a></div><div class="panel"><form class="filters"><input name="q" value="@Context.Request.Query["q"]" class="form-control" aria-label="Search users" placeholder="Search email"/><button class="btn btn-outline-secondary">Search</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Email</th><th>Role</th><th>Active</th><th>Locked</th><th></th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.Email</td><td>@u.Role</td><td>@u.IsActive</td><td>@u.Unlock</td><td><a asp-action="Edit" asp-route-id="@u.Id">Edit / reset password</a></td></tr>}</tbody></table></div><p class="small text-muted">Displays up to 200 matching users. Admin: full administration. Manager: business-wide CRM and team activity. SalesExecutive: assigned records only.</p></div>
