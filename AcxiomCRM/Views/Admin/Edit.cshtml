@model UserVm
@{ViewData["Title"]="Edit user";}
<h1>@(string.IsNullOrEmpty(Model.Id)?"Create user":"Edit user")</h1><div class="panel"><form method="post" asp-action="Edit"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" required/></div><div class="col-md-6"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select">@foreach(var r in Roles.All){<option>@r</option>}</select></div><div class="col-12"><label asp-for="Password" class="form-label">New password (leave blank to keep existing)</label><input asp-for="Password" class="form-control" autocomplete="new-password"/><small>10+ characters with uppercase, lowercase, number and symbol.</small></div><div class="col-12"><label><input asp-for="IsActive"/> Active account</label> <label class="ms-3"><input asp-for="Unlock"/> Unlock account</label></div></div><button class="btn btn-primary mt-4">Save user</button></form></div>
